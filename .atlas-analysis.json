  "keyFeatures": [
    "Entity 360 — unified record of every customer across KYC, KYB, AML, and transaction history",
    "KYC Identity Verification — government ID matching, biometric liveness, and facial comparison",
    "KYB Business Verification — company search, UBO verification, and business address checks",
    "AML Screening — PEP & sanctions screening, adverse media intelligence, and custom watchlists",
    "Transaction Monitoring (KYT) — real-time transaction risk evaluation and alert management",
    "Risk Scoring — configurable, weighted risk model per entity updated continuously",
    "Case Management — create, triage, and resolve compliance cases with AI summaries",
    "Webhooks — real-time event notifications for KYC, KYT, and alert lifecycle events",
    "Mobile & Web SDKs — Android, iOS, and Web SDKs for liveness detection and document capture",
    "Multi-country Support — Africa, EMEA, and global coverage with country-specific ID types",
    "Sandbox & Production Environments — isolated test environment with dedicated base URLs",
    "SOC 2 Type II, ISO 27001 / 27018 / 42001, GDPR compliant"
  ],
  "publicApiSurface": [
    "POST /v2/api/entities — Create Entity",
    "GET /v2/api/entities — Get All Entities",
    "GET /v2/api/entities/{id} — Get Entity by ID",
    "POST /v2/api/entities/{id}/verify/kyc — Verify Entity (KYC)",
    "POST /v2/api/entities/{id}/verify/kyb — Verify Entity (KYB)",
    "POST /v2/api/entities/{id}/verify/aml — Verify Entity (AML)",
    "POST /v2/api/identity/verify — ID Data Matching (eIDV)",
    "POST /v2/api/identity/facial-comparison — Facial Comparison",
    "POST /v2/api/address/verify — Address Verification",
    "POST /v2/api/aml/search — PEP & Sanction Screening",
    "POST /v2/api/aml/adverse-media — Adverse Media Search",
    "POST /v2/api/watchlist — Custom AML Watchlist Upload",
    "POST /v2/api/kyt/clients — Create KYT Client",
    "POST /v2/api/kyt/transactions — Create Transaction",
    "GET /v2/api/kyt/evaluations/{id} — Retrieve Evaluation",
    "POST /v2/api/cases — Create Case",
    "GET /v2/api/cases — Retrieve All Cases",
    "GET /v2/api/cases/{id}/summary — Get Case AI Summary",
    "GET /v2/api/signals — List Signals by Entity",
    "POST /v2/api/risk/check — Initialise Risk Intelligence Check",
    "POST /v2/api/sdk/liveness-token — Generate SDK Liveness Token",
    "POST /v2/api/sdk/session-id — Generate SDK Session ID"
  ]
